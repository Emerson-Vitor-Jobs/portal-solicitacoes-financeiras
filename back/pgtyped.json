{
  "transforms": [
    { "mode": "sql", "include": "**/*.sql", "emitTemplate": "{{dir}}/{{name}}.queries.ts" }
  ],
  "srcDir": "./src/repository/postgres/queries",
  "failOnError": true,
  "camelCaseColumnNames": false,
  "typesOverrides": {
    "date": { "parameter": "string", "return": "string" }
  }
}
