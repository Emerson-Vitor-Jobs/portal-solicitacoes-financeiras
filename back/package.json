{
  "name": "gex-back",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "./scripts/test-integration.sh",
    "gen:sql": "./scripts/gen-sql.sh",
    "gen:openapi": "tsx scripts/gen-openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@pgtyped/cli": "2.4.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@node-rs/argon2": "2.2.1",
    "@pgtyped/runtime": "2.4.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pg": "8.23.0",
    "zod": "4.6.5"
  }
}
